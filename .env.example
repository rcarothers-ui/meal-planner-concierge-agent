# Google Cloud Project & Region Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret IDs (Secrets are fetched dynamically via google-cloud-secret-manager)
USDA_NUTRITION_API_SECRET_ID=usda-fooddata-central-api-key
INSTACART_CONNECT_SECRET_ID=instacart-partner-api-key
GOOGLE_CALENDAR_OAUTH_SECRET_ID=google-calendar-oauth-credentials

# Persistent Session & Vector Search Configuration
FIRESTORE_COLLECTION_SESSIONS=meal_planner_sessions
VERTEX_VECTOR_SEARCH_INDEX_ENDPOINT=projects/your-gcp-project-id/locations/us-central1/indexEndpoints/meal-memory-endpoint
VERTEX_AI_SEARCH_DATASTORE_ID=nutritional-recipes-datastore

# Observability & Security Configuration
ENABLE_CLOUD_TRACE=true
ENABLE_CLOUD_DLP_REDACTION=true
HITL_MAX_AUTO_APPROVE_BUDGET_USD=150.00
